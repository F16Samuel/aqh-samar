# =============================================================================
# AQH-SAMAR — Environment Variables Reference
# Copy this file to .env (backend) and .env.local (frontend) and fill values.
# NEVER commit actual secrets to version control.
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://<your-project>.supabase.co

# anon/public key — safe to expose to the frontend
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# service_role key — BACKEND ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# JWT secret used by Supabase to sign tokens
# Found in Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# ─── Database ─────────────────────────────────────────────────────────────────
# Async SQLAlchemy connection string (use asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>

# Synchronous URL for Alembic (uses psycopg2 / standard driver)
DATABASE_SYNC_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# ─── FastAPI / Backend ────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://<your-vercel-domain>.vercel.app

# Environment tag: development | staging | production
APP_ENV=development

# Secret key used for any internal signing (e.g., CSRF tokens)
SECRET_KEY=change-me-to-a-long-random-string

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# All VITE_ prefixed vars are embedded at build time by Vite
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ─── Railway (optional overrides) ────────────────────────────────────────────
PORT=8000
